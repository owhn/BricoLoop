{
  "name": "bricoloop",
  "version": "0.1.0",
  "private": true,
  "description": "API de prêt d'outils entre voisins",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
