    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
